      "jayson>uuid": "11.1.1",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "katex@<0.18.2": "0.18.11",
      "nanoid@<3.3.18": "3.3.20",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "next>postcss": "8.5.29",
      "next>sharp": "0.35.5",
      "undici@>=6.0.0 <6.28.1": "6.29.0",
      "undici@>=7.0.0 <7.29.1": "7.30.0",
      "undici@>=8.0.0 <8.10.2": "8.11.2"
    }
  }
