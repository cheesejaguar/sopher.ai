      "@esbuild-kit/core-utils>esbuild": "0.25.0",
      "@lhci/cli>chrome-launcher": "1.2.1",
      "@lhci/cli>tmp": "0.2.7",
      "@lhci/cli>uuid": "11.1.1",
      "@swc/cli>minimatch": "10.2.6",
      "ejs>jake": "12.10.1",
      "external-editor>tmp": "0.2.7",
      "jayson>uuid": "11.1.1",
