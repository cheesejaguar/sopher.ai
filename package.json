{
  "name": "sopher-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:changed": "vitest run --changed",
    "test:db-integration": "vitest run --config vitest.db-integration.config.ts",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:quick": "pnpm typecheck && pnpm test",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "vercel-build": "tsx scripts/migrate-production.ts && next build",
    "e2e:seed": "tsx scripts/seed-e2e.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=light"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.103",
    "@ai-sdk/react": "^4.0.130",
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.10",
    "@clerk/themes": "^2.4.57",
    "@neondatabase/serverless": "^1.2.0",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/firewall": "^1.2.5",
    "@vercel/functions": "^3.9.11",
    "@vercel/speed-insights": "^2.0.0",
    "@workflow/ai": "^4.2.0",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.8.1",
    "drizzle-orm": "^0.45.3",
    "epub-gen-memory": "^1.1.2",
    "isomorphic-dompurify": "^3.22.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "mermaid": "^11.16.1",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.2",
    "resend": "^6.32.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "stripe": "^22.3.2",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@workflow/vitest": "^4.0.14",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.0",
      "@lhci/cli>chrome-launcher": "1.2.1",
      "@lhci/cli>tmp": "0.2.7",
      "@lhci/cli>uuid": "11.1.1",
      "@modelcontextprotocol/sdk>hono": "4.12.34",
      "@swc/cli>minimatch": "10.2.6",
      "ajv>fast-uri": "3.1.5",
      "dompurify@<=3.4.12": "3.4.13",
      "ejs>jake": "12.10.1",
      "external-editor>tmp": "0.2.7",
      "jayson>uuid": "11.1.1",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "minimatch@10.2.6>brace-expansion": "5.0.9",
      "minimatch@3.1.5>brace-expansion": "1.1.18",
      "nanoid@<3.3.17": "3.3.17",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "next>postcss": "8.5.23",
      "next>sharp": "0.35.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0"
    }
  }
}
