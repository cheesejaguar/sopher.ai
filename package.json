    "@workflow/ai": "^4.2.0",
    "ai": "^7.0.37",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "epub-gen-memory": "^1.1.2",
    "isomorphic-dompurify": "^3.20.0",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.2",
    "resend": "^6.18.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "svix": "^1.99.1",
