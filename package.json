{
  "name": "sopher-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db-integration": "vitest run --config vitest.db-integration.config.ts",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "vercel-build": "drizzle-kit migrate && next build",
    "e2e:seed": "tsx scripts/seed-e2e.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.28",
