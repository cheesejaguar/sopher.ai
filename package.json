    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.1",
    "@vercel/firewall": "^1.2.6",
    "@vercel/functions": "^3.9.11",
    "ai": "^7.0.129",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.8.1",
    "drizzle-orm": "^0.45.3",
    "epub-gen-memory": "^1.1.2",
    "isomorphic-dompurify": "^4.5.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "mermaid": "^11.17.2",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.2",
    "resend": "^6.32.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@workflow/vitest": "^5.0.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.0",
      "@lhci/cli>chrome-launcher": "1.2.1",
